#!/usr/bin/env bash
# After every commit, append one journal line to the project's Obsidian note.
# Enable once per clone: git config core.hooksPath scripts/githooks
# The vault path comes from Obsidian's own config, so nothing is hard-coded.
set -u
cfg="${APPDATA:-}/obsidian/obsidian.json"
[ -f "$cfg" ] || exit 0
note=""
for vault in $(python -I -c "import sys,json; d=json.load(open(sys.argv[1],encoding='utf-8')); [print(v['path']) for v in d.get('vaults',{}).values()]" "$cfg" 2>/dev/null); do
  [ -f "$vault/SolaniSense/SolaniSense.md" ] && note="$vault/SolaniSense/SolaniSense.md" && break
done
[ -n "$note" ] || exit 0
line="- $(date +%Y-%m-%d): commit $(git log -1 --format='%h %s') ($(git rev-parse --abbrev-ref HEAD))"
grep -qF -- "$line" "$note" || printf '%s\n' "$line" >> "$note"
exit 0
